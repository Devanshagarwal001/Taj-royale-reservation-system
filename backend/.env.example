# ==========================================================
# Restaurant Table Reservation System — Backend Environment
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# ---------- Server ----------
# Runtime environment: development | production | test
NODE_ENV=development
# Port the Express server listens on
PORT=5000
# Base URL of the API (useful for logging / building absolute links)
API_BASE_URL=http://localhost:5000

# ---------- Database (MongoDB Atlas) ----------
# Full MongoDB Atlas connection string (include username, password, cluster, and db name)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reservation_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/reservation_db?retryWrites=true&w=majority

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,https://your-production-domain.com
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:3000

# ---------- Cookies / Sessions ----------
# Secret used to sign cookies (generate a long random string)
COOKIE_SECRET=change_this_to_a_long_random_string
# Secret used to sign JWT auth tokens
JWT_SECRET=change_this_to_a_long_random_jwt_secret

# ---------- Rate Limiting ----------
# Time window in milliseconds
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP per window
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Logging ----------
# Morgan format: dev | combined | common | short | tiny
LOG_FORMAT=dev
